# URL du serveur Ollama (local ou distant)
OLLAMA_URL=http://localhost:11434

# Modèle GLM vision (CIN, ICE image/PDF scanné, liasse)
# Exemples : hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
OLLAMA_MODEL=glm4v
OLLAMA_TEXT_MODEL=glm4
# Optionnel — si absent, utilise OLLAMA_MODEL
# OLLAMA_VISION_MODEL=glm4v

# Timeout (secondes) pour les appels Ollama
OLLAMA_TIMEOUT=300

# --- Mapping financier Qwen (même OLLAMA_URL que GLM Vision) --------------
OLLAMA_MAPPING_MODEL=qwen3:8b
OLLAMA_MAPPING_TIMEOUT_SECONDS=300
OLLAMA_MAPPING_NUM_CTX=32768
OLLAMA_MAPPING_NUM_PREDICT=8192
OLLAMA_MAPPING_KEEP_ALIVE=5m
OLLAMA_MAPPING_MAX_ATTEMPTS=3
OLLAMA_MAPPING_MAX_SECTION_CHARS=60000
OLLAMA_MAPPING_SPLIT_THRESHOLD_CHARS=12000

ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=50

# --- ICE ------------------------------------------------------------------
PDF_TO_IMAGE_DPI=150
MIN_NATIVE_TEXT_CHARS=40
MAX_IMAGE_DIMENSION=1200

# --- Liasse OCR -----------------------------------------------------------
OCR_MAX_PAGES=70
OCR_MAX_CONCURRENCY=1
OCR_RETRY_ATTEMPTS=5
OCR_RETRY_DELAY=15
OCR_PAGE_DELAY=4
OCR_FAILED_PASS_DELAY=20
# Tokens max de réponse Vision (réduit les 504 sur gateway distant)
OCR_VISION_NUM_PREDICT=8192
# true = un 504 au warmup n'empêche pas /extraction/liasse
OCR_SOFT_WARMUP=true
SCORING_MIN_COMPLETENESS_PCT=50
