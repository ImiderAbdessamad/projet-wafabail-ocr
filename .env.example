# URL du serveur Ollama local
OLLAMA_URL=http://localhost:11434

# Nom du modèle GLM vision à utiliser (doit être déjà téléchargé dans Ollama).
# Exemples de modèles GLM avec support vision disponibles sur ollama.com :
#   - hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
#   - glm-4.6v:9b-flash-q4_K_M
#   - haervwe/GLM-4.6V-Flash-9B
OLLAMA_MODEL=glm4v

# Timeout (en secondes) pour l'appel au modèle vision
OLLAMA_TIMEOUT=120

# Origines autorisées pour le CORS (séparées par des virgules). "*" = toutes.
ALLOWED_ORIGINS=*

# Taille maximale d'upload autorisée, en Mo
MAX_UPLOAD_MB=15

# --- Extraction ICE (aucune dépendance système requise) --------------------

# Nom du modèle GLM texte à utiliser pour structurer l'ICE depuis un PDF
# numérique. Peut être le même modèle que OLLAMA_MODEL s'il gère aussi le
# texte (cas des modèles GLM vision, qui gèrent texte + image).
OLLAMA_TEXT_MODEL=glm4

# Résolution (DPI) de conversion des pages PDF scannées en image (PyMuPDF,
# avant envoi au modèle vision — remplace Tesseract/Poppler)
PDF_TO_IMAGE_DPI=200

# Seuil (en caractères) sous lequel un PDF est considéré comme "scanné"
# (texte natif insuffisant) et bascule sur le pipeline vision (image)
MIN_NATIVE_TEXT_CHARS=40
